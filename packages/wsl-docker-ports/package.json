{
  "name": "dsh-wsl-docker-ports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WSL Docker 管理器 + 端口转发可视化（插件包）：只读事实层（docker / netsh）与（后续）写路径",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "dsh-wsl-shared": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
