{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "lib/types",
    "rootDir": "src"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
