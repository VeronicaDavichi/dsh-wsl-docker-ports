{
  "name": "dsh-wsl-docker-containers",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "WSL Docker 管理器 · 容器页（插件包）：列出/启停/重启容器并查看日志，零提权",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\" && vitest run",
    "test:client": "vitest run",
    "check:client": "node scripts/verify-client-loader.mjs && node scripts/assert-client-split.mjs",
    "check:borders": "node ../../wsl-docker-core/scripts/check-borders.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:size": "node ../wsl-shared/scripts/check-size.mjs",
    "check:host": "node scripts/verify-host-entry.mjs"
  },
  "dependencies": {
    "dsh-wsl-docker-core": "workspace:*",
    "dsh-wsl-shared": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vitest": "^5.0.3"
  },
  "files": [
    "lib/**",
    "locale/**"
  ]
}
