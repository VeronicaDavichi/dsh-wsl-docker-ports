{
  "name": "dsh-terminal-profiles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "可配置受管终端（插件包）：profile 驱动的真 PTY 右栏终端；Phase 1 配置模型 + Phase 2 Host PTY 与屏幕模型",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "dsh-wsl-shared": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
