{
  "name": "dsh-wsl-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 的 WSL 工具集：可配置受管终端（受管 PTY）+ WSL Docker 端口转发管理",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:all": "pnpm -r --if-present test:all",
    "check:exports": "pnpm -r --if-present check:exports",
    "check:size": "pnpm -r --if-present check:size",
    "check:scope": "pnpm -r --if-present check:scope"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
